@inject NavigationManager nvgMgr;
@using System.Globalization;

@page "/"

<style>
    :root {
        --bg: #302b22;
        --fg: #b5a78f;
        --fg-font: #302b22;
        --bg-font: #b5a78f;
        --panel: #3b352c;
        --accent: #b5a78f;
        --muted: #cfc6bb;
        --active: #ffd27a;
        --radius: 12px;
    }

    .component-wrap {
        width: 100%;
        min-height: 100vh;
        background: var(--bg);
        display: flex;
        justify-content: center;
        padding: 32px;
        box-sizing: border-box;
    }

    .container {
        width: 980px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(0,0,0,0.02));
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.6);
        color: var(--muted);
        display: grid;
        grid-template-columns: 420px 1fr;
        gap: 24px;
        align-items: start;
    }

    .preview {
        background: var(--panel);
        border-radius: var(--radius);
        padding: 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        align-items: center;
    }

        .preview img, .preview canvas {
            width: 100%;
            max-width: 420px;
            height: auto;
            image-rendering: pixelated;
            border-radius: 8px;
            background: var(--fg);
            padding: 6px;
            box-sizing: border-box;
        }

    .controls {
        background: transparent;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .top-row {
        display: flex;
        gap: 12px;
    }

    .btn {
        background: var(--bg);
        border: 1px solid var(--bg-font);
        padding: 10px 14px;
        border-radius: 10px;
        cursor: pointer;
        color: var(--bg-font);
    }

        .btn.primary {
            background: var(--fg);
            color: var(--fg-font);
            font-weight: 600;
            border: none;
        }

    fieldset {
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 10px;
        padding: 10px 12px;
        background-color: var(--fg);
    }

    legend {
        color: var(--fg-font);
        padding: 0 6px;
        font-weight: 600;
    }

    .grid-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
    }

    .option-btn {
        padding: 6px 10px;
        border-radius: 8px;
        border: 1px solid var(--bg);
        background: transparent;
        cursor: pointer;
    }

        .option-btn.active-button {
            background: var(--bg);
            color: var(--bg-font);
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
        }

    .range {
        width: 100%;
    }

    .small-input {
        width: 200px;
        padding: 6px 8px;
        border-radius: 8px;
        border: none;
    }

    .morph-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }

    .footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 12px;
    }

    .note {
        font-size: 12px;
        color: var(--fg-font);
    }

    @@media (max-width:980px) {
        .container

    {
        grid-template-columns: 1fr;
    }

    }
</style>

<div class="component-wrap">
    <div class="container">

        <div class="preview">
            @if (!string.IsNullOrEmpty(_sprite))
            {
                <img src="@_sprite" alt="monster sprite" />
            }
            else
            {
                <div style="width:300px; height:300px; display:flex; align-items:center; justify-content:center; color:var(--muted);">No sprite yet — click Generate</div>
            }

            <div style="display:flex; gap:8px; width:100%; justify-content:center;">
                <button class="btn" style="height:56px;" @onclick="() => { _settings = new Classes.Settings(); }">Reset</button>
                <button class="btn primary" style="width:200px; height:56px;" @onclick="GenerateMonsterSprite">Generate</button>
            </div>
        </div>

        <div class="controls">
            <fieldset>
                <legend>Advanced</legend>
                <div class="morph-grid">
                    <div>
                        <label style="margin-top:10px;" class="note">Dimension</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @( _settings.Dimension == 32 ? "active-button" : "")" @onclick="(() => _settings.Dimension = 32)">32px</button>
                            <button class="option-btn @( _settings.Dimension == 48 ? "active-button" : "")" @onclick="(() => _settings.Dimension = 48)">48px</button>
                            <button class="option-btn @( _settings.Dimension == 64 ? "active-button" : "")" @onclick="(() => _settings.Dimension = 64)">64px</button>
                            <button class="option-btn @( _settings.Dimension == 128 ? "active-button" : "")" @onclick="(() => _settings.Dimension = 128)">128px</button>
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Margin (@_settings.Margin.ToString())px</label>
                            <input class="range" type="range" min="0" max="12" @bind="_settings.Margin" />
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Seed</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseSeed ? "active-button" : "")" @onclick="(() => _settings.UseSeed = !_settings.UseSeed)">Use</button>
                            <input class="small-input" type="number" @bind="_settings.Seed" disabled="@(!_settings.UseSeed)" />
                        </div>
                    </div>
                 </div>
            </fieldset>

            <fieldset>
                <legend>Body</legend>

                <label class="note">Archetype</label>
                <div class="grid-buttons">
                    @foreach (Classes.BodyArchetype item in Enum.GetValues(typeof(Classes.BodyArchetype)))
                    {
                        <button class="option-btn @(_settings.bodyArchetype == item ? "active-button" : "")" @onclick="(() => _settings.bodyArchetype = item)">@item</button>
                    }
                </div>

                <label class="note">Advanced</label>
                <div class="grid-buttons" style="margin-top:10px;">
                    <button class="option-btn @(_settings.NoiseStyle == Classes.NoiseStyle.Blobby ? "active-button" : "")" @onclick="(() => _settings.NoiseStyle = Classes.NoiseStyle.Blobby)">Blobby</button>
                    <button class="option-btn @(_settings.NoiseStyle == Classes.NoiseStyle.Balanced ? "active-button" : "")" @onclick="(() => _settings.NoiseStyle = Classes.NoiseStyle.Balanced)">Balanced</button>
                    <button class="option-btn @(_settings.NoiseStyle == Classes.NoiseStyle.Detailed ? "active-button" : "")" @onclick="(() => _settings.NoiseStyle = Classes.NoiseStyle.Detailed)">Detailed</button>
                    <button class="option-btn @(_settings.NoiseStyle == Classes.NoiseStyle.Random ? "active-button" : "")" @onclick="(() => _settings.NoiseStyle = Classes.NoiseStyle.Random)">Random</button>
                </div>
            </fieldset>

            <fieldset>
                <legend>Colors & Palette</legend>

                <label class="note">Color of Parts</label>
                <div class="grid-buttons">
                    <button class="option-btn @(_settings.ColorStyle == Classes.ColorStyle.Harmonious ? "active-button" : "")" @onclick="(() => _settings.ColorStyle = Classes.ColorStyle.Harmonious)">Harmonious</button>
                    <button class="option-btn @(_settings.ColorStyle == Classes.ColorStyle.RandomAccent ? "active-button" : "")" @onclick="(() => _settings.ColorStyle = Classes.ColorStyle.RandomAccent)">Random Accent</button>
                    <button class="option-btn @(_settings.ColorStyle == Classes.ColorStyle.RandomDarken ? "active-button" : "")" @onclick="(() => _settings.ColorStyle = Classes.ColorStyle.RandomDarken)">Random Patterns</button>
                    <button class="option-btn @(_settings.ColorStyle == Classes.ColorStyle.RandomOutline ? "active-button" : "")" @onclick="(() => _settings.ColorStyle = Classes.ColorStyle.RandomOutline)">Random Outline</button>
                </div>

                <div style="margin-top:10px;">
                    <label class="note">Number of Colors for Palette: @_settings.numberOfColors</label>
                    <input class="range" type="range" min="1" max="8" @bind="_settings.numberOfColors" />
                </div>

                <label style="margin-top:10px;" class="note">Palette</label>
                <div class="grid-buttons">
                    @foreach (Classes.PaletteMode mode in Enum.GetValues(typeof(Classes.PaletteMode)))
                    {
                        <button class="option-btn @(_settings.paletteMode == mode ? "active-button" : "")" @onclick="(() => _settings.paletteMode = mode)">@mode</button>
                    }
                </div>
            </fieldset>

            <fieldset>
                <legend>Face & Limbs</legend>

                <label class="note">Eyes</label>
                <div class="grid-buttons">
                    @foreach (Classes.EyeStyle e in Enum.GetValues(typeof(Classes.EyeStyle)))
                    {
                        <button class="option-btn @(_settings.eyeStyle == e ? "active-button" : "")" @onclick="(() => _settings.eyeStyle = e)">@e</button>
                    }
                </div>

                <div style="margin-top:10px;">
                    <label class="note">Number: @(_settings.eyeCount > 6 ? "Random" : _settings.eyeCount.ToString())</label>
                    <input class="range" type="range" min="1" max="7" @bind="_settings.eyeCount" />
                </div>

                <label style="margin-top:10px;" class="note">Mouth</label>
                <div class="grid-buttons">
                    @foreach (Classes.MouthStyle m in Enum.GetValues(typeof(Classes.MouthStyle)))
                    {
                        <button class="option-btn @(_settings.mouthStyle == m ? "active-button" : "")" @onclick="(() => _settings.mouthStyle = m)">@m</button>
                    }
                </div>

                <label style="margin-top:10px;" class="note">Limbs</label>
                <div class="grid-buttons">
                    @foreach (Classes.LimbStyle l in Enum.GetValues(typeof(Classes.LimbStyle)))
                    {
                        <button class="option-btn @(_settings.limbStyle == l ? "active-button" : "")" @onclick="(() => _settings.limbStyle = l)">@l</button>
                    }
                </div>
            </fieldset>

            <fieldset>
                <legend>Body Morphology</legend>
                <div class="morph-grid">
                    <div>
                        <label style="margin-top:10px;" class="note">Segments</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseSegments ? "active-button" : "")" @onclick="(() => _settings.UseSegments = !_settings.UseSegments)">Use</button>
                            <label class="note">@(_settings.NumberOfSegments.ToString())</label>
                            <input class="range" type="range" min="1" max="12" @bind="_settings.NumberOfSegments" disabled="@(!_settings.UseSegments)" />
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Lobes</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseLobes ? "active-button" : "")" @onclick="(() => _settings.UseLobes = !_settings.UseLobes)">Use</button>
                            <label class="note">@(_settings.NumberOfLobes.ToString())</label>
                            <input class="range" type="range" min="1" max="12" @bind="_settings.NumberOfLobes" disabled="@(!_settings.UseLobes)" />
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Holes</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseHoles ? "active-button" : "")" @onclick="(() => _settings.UseHoles = !_settings.UseHoles)">Use</button>
                            <label class="note">@(_settings.NumberOfHoles.ToString())</label>
                            <input class="range" type="range" min="1" max="12" @bind="_settings.NumberOfHoles" disabled="@(!_settings.UseHoles)" />
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Protrusions</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseProtrusions ? "active-button" : "")" @onclick="(() => _settings.UseProtrusions = !_settings.UseProtrusions)">Use</button>
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Morphologic Clean</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseMorphologicClean ? "active-button" : "")" @onclick="(() => _settings.UseMorphologicClean = !_settings.UseMorphologicClean)">Use</button>
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Erosion</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseErosion ? "active-button" : "")" @onclick="(() => _settings.UseErosion = !_settings.UseErosion)">Use</button>
                            <label class="note">@(_settings.NumberOfErosions.ToString())</label>
                            <input class="range" type="range" min="1" max="12" @bind="_settings.NumberOfErosions" disabled="@(!_settings.UseErosion)" />
                        </div>
                    </div>

                    <div>
                        <label style="margin-top:10px;" class="note">Dilatation</label>
                        <div style="display:flex; gap:8px;">
                            <button class="option-btn @(_settings.UseDilatation ? "active-button" : "")" @onclick="(() => _settings.UseDilatation = !_settings.UseDilatation)">Use</button>
                            <label class="note">@(_settings.NumberOfDilatations.ToString())</label>
                            <input class="range" type="range" min="1" max="12" @bind="_settings.NumberOfDilatations" disabled="@(!_settings.UseDilatation)" />
                        </div>
                    </div>
                </div>
            </fieldset>

            <fieldset>
                <legend>Animation</legend>

                <div style="margin-top:10px;">
                    <label class="note">Frames: @_settings.FrameCount</label>
                    <input class="range" type="range" min="1" max="16" @bind="_settings.FrameCount" />
                </div>

                <div style="margin-top:10px;">
                    <label class="note">Frame delay: @_settings.FrameDelayInMs ms</label>
                    <input class="range" type="range" min="20" max="200" @bind="_settings.FrameDelayInMs" />
                </div>

                <div style="margin-top:10px;">
                    <label class="note">Animation intensity: @_settings.AnimationIntesity</label>
                    <input class="range" type="range" min="0.2" max="4" step="0.1" @bind="_settings.AnimationIntesity" />
                </div>

            </fieldset>

            <div class="footer">
                <div class="note">Tip: same seed + settings = same monster</div>
                <div>
                    <button class="btn" @onclick="NavigateToPalette">Palette Generator</button>
                </div>
            </div>

        </div>

    </div>
</div>





